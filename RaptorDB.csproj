<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <AssemblyName>RaptorDB</AssemblyName>
    <RootNamespace>RaptorDB</RootNamespace>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <Description>RaptorDB — Lightweight custom RDBMS engine built in C# (.NET 10) — v2.0 adds INNER / LEFT / RIGHT and chained multi-table JOIN support</Description>
    <Authors>Prayas (@captainprice27)</Authors>
    <Copyright>© 2025-2026 Prayas</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="RaptorDB\Databases\default_db\" />
  </ItemGroup>

</Project>
